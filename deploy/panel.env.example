# /etc/ladder-panel/panel.env
LADDER_LISTEN=:8080
LADDER_DB=/var/lib/ladder-panel/panel.db
# 可选：初始管理员密码，仅数据库尚无密码哈希的首次初始化生效。
# 不设置时 Panel 随机生成并打印一次到日志（journalctl -u ladder-panel | grep 初始密码）。
# LADDER_ADMIN_PASSWORD=
# JWT 会话 HMAC 密钥。保持注释/缺省时 install-panel.sh 会生成随机值写入；
# 若进程环境也没有，Panel 自动生成并持久化到 session.secret（与 panel.db 同目录）。
# 注意：写成空值（LADDER_SESSION_SECRET=）会让安装脚本认为已配置而跳过生成。
# LADDER_SESSION_SECRET=
# 可选：32 字节主密钥（hex:/base64: 前缀）。为空时 Panel 会在数据目录
# secrets/credentials.key 自动生成；备份 panel.db 时必须同时备份该文件。
# LADDER_CREDENTIALS_KEY=hex:<64 个十六进制字符>

# 启动时对已登记节点自动下发配置并 Start
LADDER_BOOTSTRAP=true
LADDER_BOOTSTRAP_TIMEOUT=3m
LADDER_BOOTSTRAP_RETRY=true
LADDER_BOOTSTRAP_RETRY_INTERVAL=30s
