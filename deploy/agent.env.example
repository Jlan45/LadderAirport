# /etc/ladder-agent/agent.env
# 由 Panel 生成的一键安装命令写入真实值（scripts/install-agent.sh），不要手工生成或替换管理证书。
LADDER_LISTEN=0.0.0.0:50051
# Panel 注册时签发的随机控制令牌，经 unit 的 EnvironmentFile 注入环境，不放命令行；
# Agent 拒绝空值与弱默认值 changeme（agent/cmd/ladder-agent/main.go）。留空仅作模板示意。
LADDER_TOKEN=
LADDER_DATA_DIR=/var/lib/ladder-agent
LADDER_TLS_CERT=/etc/ladder-agent/tls/server.crt
LADDER_TLS_KEY=/etc/ladder-agent/tls/server.key
LADDER_TLS_CLIENT_CA=/etc/ladder-agent/tls/ca.crt
LADDER_PANEL_URL=https://panel.example.com
LADDER_NODE_ID=
# 可选：首次注册时上报给 Panel 的控制面地址（留空自动探测）
LADDER_REPORT_ADDRESS=
# 可选：额外证书 SAN，逗号分隔，如 DNS:node.example.com,IP:203.0.113.10
LADDER_TLS_EXTRA_SANS=
# 可选：1 时 Agent 用与证书续签相同的 Panel HTTP + Bearer 定时上报并拉配置
LADDER_UPLINK=0
# 可选：uplink 节点默认不监听 gRPC 控制端口（无 push 能力）。设为 1 可继续监听以保留 push 拨号能力
LADDER_UPLINK_SERVE_GRPC=0
